# Terraform files
*.tfstate
*.tfstate.*

# Crash log files
crash.log

# Ignore override files as they are usually local-only
*.override.tf
*.override.tf.json

# Include .terraformrc and terraform.rc for Terraform CLI configuration
.terraformrc
terraform.rc

# Ignore directories created by Terraform
.terraform/

# Ignore sensitive files
*.tfvars
*.tfvars.json

# Ignore backup files
*.backup

# Ignore plan files
*.tfplan
*.tfplan.*